# Normalize text files to LF in the repository.
* text=auto eol=lf

# Explicit text files.
*.md   text eol=lf
*.py   text eol=lf
*.txt  text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.tex  text eol=lf
*.csv  text eol=lf

# Windows scripts keep CRLF when needed.
*.ps1  text eol=crlf
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binary files.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.mp4  binary
*.pdf  binary
*.zip  binary